# Build outputs
.task
bin
dist
# The bundle is generated, but the directory has to survive into the published
# module: main.go's sibling gui.go embeds it with //go:embed, and an embed
# pattern that matches nothing is a compile error. So the placeholder is
# tracked and everything else here is not — that is what makes
# `go install github.com/otis-http/otis@latest` produce a working `otis`
# command rather than failing to build. See gui.go's assetsPresent.
frontend/dist/*
!frontend/dist/.gitkeep
# `go build .` in the repo root drops the binary here; the real one is bin/otis.
/otis

# Dependencies
frontend/node_modules

# Platform packaging artefacts
build/linux/appimage/build
build/linux/appimage/otis
build/linux/appimage/otis.png
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# Derived from build/appicon.png by `generate:icons`; the PNG and the SVG it
# renders from are the committed sources.
build/darwin/icons.icns
build/darwin/httpFileIcon.icns
build/windows/icon.ico
build/windows/httpFileIcon.ico

# Mobile generated (per-machine; overlays hold absolute paths)
build/ios/xcode/overlay.json
build/ios/xcode/gen/
build/android/overlay.json
build/android/gen/

# OS / editor noise
.DS_Store
*.log
