<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="otis"
        Arguments=""
        InstallLocation="C:\Program Files\Otis\Otis">
    </Installer>
    <PackageInformation
        PackageName="Otis"
        PackageDisplayName="Otis"
        PublisherName="CN=Otis"
        PublisherDisplayName="Otis"
        Version="0.1.0.0"
        PackageDescription="File-based HTTP client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.otis-http.otis"
                Description="File-based HTTP client"
                DisplayName="Otis"
                ExecutableName="otis"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Otis</DisplayName>
            <PublisherDisplayName>Otis</PublisherDisplayName>
            <Description>File-based HTTP client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="otis.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
